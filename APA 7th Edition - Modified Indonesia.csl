    font-family: Helvetica, Arial, sans-serif;
    font-size: 13px;
    display: block;
    background-color: #222222;
    margin: 0px;
    padding: 0;
    height: 40px;
    -webkit-box-shadow: 0 2px 2px rgba(0, 0, 0, 0.2);
    z-index: 20;
    position: relative;
  }

  #navigationBar ul {
    margin: 0;
    padding: 0 0 0 6px;
    list-style-type: none;
  }

  #navigationBar li {
    margin: 0;
    padding: 0;
    float: left;
  }

  #navigationBar li a {
    display: block;
    float: left;
    padding: 0 15px;
    line-height: 40px;
    color: #999999;
    text-decoration: none;
  }

  #navigationBar li a:hover {
    color: #FFFFFF;
  }

  body#homepage a#nav_home,
  body#searchByName a#nav_searchByName,
  body#searchByExample a#nav_searchByExample,
  body#visualEditor a#nav_visualEditor,
  body#codeEditor a#nav_codeEditor,
  body#about a#nav_about {
    color: #FFFFFF;
    background: #000000;
  }

  .search-box {
    font-size: 16px;
    width: 200px;
    margin-top: 8px;
    position: absolute;
    right: 10px;
  }</style><nav id="navigationBar"><ul><li><a href="https://csl.mendeley.com/about/" id="nav_about">About</a></li><li><a href="https://csl.mendeley.com/searchByName/" id="nav_searchByName">Search by name</a></li><li><a href="https://csl.mendeley.com/searchByExample/" id="nav_searchByExample">Search by example</a></li><li><a href="https://csl.mendeley.com/visualEditor/" id="nav_visualEditor">Visual editor</a></li><li><a href="https://csl.mendeley.com/codeEditor/" id="nav_codeEditor">Code editor</a></li></ul></nav><style>#unsupportedBrowserMessage {
